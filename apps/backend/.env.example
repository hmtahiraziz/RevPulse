# HubSpot public app credentials (Developer account -> Apps -> Auth tab)
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret

# Must EXACTLY match the redirect URL configured in your HubSpot app's Auth tab
HUBSPOT_REDIRECT_URI=http://localhost:3000/oauth-callback

# Space-separated scopes. "oauth" is required. Add the contacts + deals read scopes.
HUBSPOT_SCOPES=crm.objects.contacts.read crm.objects.deals.read oauth

# Neon Postgres connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Where the frontend runs (used for CORS + post-OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Backend port
PORT=3000

# Optional: enable Stripe revenue enrichment (test key recommended: sk_test_...).
# If omitted, the app runs normally and the revenue UI is hidden.
STRIPE_SECRET_KEY=

# Only used by the seed script (npm run seed). A HubSpot Private App token
# (pat-...) with crm.objects.contacts.write, used to insert dummy test contacts.
HUBSPOT_PRIVATE_APP_TOKEN=
